# Copy to .env and fill in. NEVER commit .env. Never use keys with withdrawal permission.
QUANTAI_ENV=research
QUANTAI_DATA_DIR=./var
# Required only to call mutating API endpoints (kill switch etc.)
QUANTAI_ADMIN_TOKEN=
# Optional alert webhook (Slack/Discord/generic JSON POST)
QUANTAI_ALERT_WEBHOOK_URL=
# Optional paid data providers (adapters not active without keys)
QUANTAI_FRED_API_KEY=
QUANTAI_POLYGON_API_KEY=
QUANTAI_OANDA_API_KEY=
# Live trading is NOT implemented. This flag alone never enables it.
QUANTAI_LIVE_TRADING_AUTHORIZED=no
